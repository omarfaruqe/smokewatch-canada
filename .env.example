# Copy to .env and adjust: cp .env.example .env

# Postgres + PostGIS (warehouse)
POSTGRES_USER=smokewatch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=smokewatch
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# MinIO (S3-compatible object storage for the bronze layer)
MINIO_ROOT_USER=smokewatch
MINIO_ROOT_PASSWORD=change-me-too
MINIO_ENDPOINT=http://localhost:9000
BRONZE_BUCKET=bronze

# CWFIS (Natural Resources Canada) GeoServer WFS
CWFIS_WFS_URL=https://cwfis.cfs.nrcan.gc.ca/geoserver/public/ows
HTTP_USER_AGENT=smokewatch-canada/0.1 (+https://github.com/omarfaruqe/smokewatch-canada)
